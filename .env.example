# Telegram bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Report yuboriladigan guruh `.env`da emas, DB'da `/setgroup` orqali saqlanadi.

# Sardoba server / production
# If PostgreSQL is outside the container but on the same host, keep host.docker.internal.
DATABASE_URL=postgresql://sardoba:sardoba@host.docker.internal:5432/sardoba_bot

# Fallback database settings
# If DATABASE_URL is set, these are ignored.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sardoba_bot
DB_USER=sardoba
DB_PASSWORD=change_me
DB_POOL_MIN=1
DB_POOL_MAX=8
DB_CONNECT_TIMEOUT=5
DB_COMMAND_TIMEOUT=60
DB_SLOW_QUERY_MS=300
