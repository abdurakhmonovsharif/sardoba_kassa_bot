# Telegram bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional group/chat for photo and report forwarding.
# Use 0 to disable group sending.
GROUP_CHAT_ID=0

# Sardoba server / production
# If PostgreSQL is outside the container but on the same host, keep host.docker.internal.
DATABASE_URL=postgresql://sardoba:sardoba@host.docker.internal:5432/sardoba_bot

# Fallback database settings
# If DATABASE_URL is set, these are ignored.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sardoba_bot
DB_USER=sardoba
DB_PASSWORD=change_me
